.training-overlay[hidden]{display:none!important}.training-overlay{position:fixed;inset:0;z-index:20000;display:flex;align-items:center;justify-content:center;padding:20px;background:#071019d9;backdrop-filter:blur(7px);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;color:#e9edf1}.training-panel{width:min(1180px,100%);max-height:calc(100dvh - 40px);display:flex;flex-direction:column;border:1px solid #536170;border-radius:16px;background:#121d28;box-shadow:0 24px 100px #000a;overflow:hidden}.training-header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 26px 14px;background:#1a2a38}.training-heading h2{margin:5px 0 0;font-size:24px;letter-spacing:1px}.training-eyebrow{color:#b8c9d8;font-size:10px;font-weight:600;letter-spacing:1.7px}.training-close{flex-shrink:0;border:1px solid #68798a;background:transparent;border-radius:7px;padding:8px 14px;color:#e9edf1;cursor:pointer;font:inherit;font-size:13px}.training-notice{margin:0;padding:11px 26px;background:#3d3320;color:#ead09a;border-block:1px solid #6b5733;font-size:12px;line-height:1.6}.training-body{overflow:auto;padding:18px 26px 24px;overscroll-behavior:contain}.training-profile{display:flex;align-items:center;flex-wrap:wrap;gap:12px 24px;font-size:13px;color:#b6c3ce}.training-player{color:#fff;font-size:16px}.training-record{margin-left:auto;color:#99bba8}.training-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-top:16px}.training-button{border:1px solid #526477;border-radius:7px;background:#243747;color:#e9edf1;padding:10px 17px;font:inherit;font-size:13px;cursor:pointer;min-height:40px;transition:background .12s,border-color .12s}.training-button:hover:not(:disabled),.training-close:hover{background:#355064;border-color:#8ba9c0}.training-primary{background:#b58c43;border-color:#d4ac65;color:#101820;font-weight:700}.training-primary:hover:not(:disabled){background:#d4ab63;color:#101820}.training-button:disabled,.training-lane-select:disabled,.training-hand-card:disabled{cursor:default;opacity:.46}.training-message{min-height:21px;margin:12px 0;color:#a7bacb;font-size:12px;line-height:1.5}.training-error{color:#ffb5a9}.training-intro{padding:32px;border:1px dashed #435a6d;border-radius:12px;background:#172735;color:#a9bccb;line-height:1.9}.training-intro h3{margin:0 0 10px;font-size:18px;color:#e9edf1}.training-intro p{font-size:13px;margin:8px 0}.training-scoreboard{display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;gap:10px;border:1px solid #405265;background:#1c2b39;border-radius:10px;padding:12px 18px;margin-bottom:12px;font-size:15px;font-weight:600}.training-own-score{color:#9ac9be}.training-enemy-score{color:#e2ab9f;text-align:right}.training-round{text-align:center;display:flex;flex-direction:column;gap:4px}.training-round strong{font-size:15px}.training-round span{font-size:12px;color:#a3bde2}.training-result{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:10px 24px;border:1px solid #736044;background:#343022;border-radius:8px;padding:14px;margin-bottom:12px;color:#e7cb90}.training-result strong{font-size:21px}.training-result span{font-size:13px}.training-lost{background:#302c2e;border-color:#6f5256;color:#e8b6ae}.training-lanes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.training-lane{background:#172431;border:1px solid #3b4c5e;border-radius:10px;padding:12px}.training-lane h3{font-size:12px;font-weight:600;color:#90a7bd;text-align:center;margin:0 0 10px}.training-unit{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:8px;min-height:70px;padding:10px 6px;border-radius:6px;font-size:12px;text-align:center}.training-enemy{background:#332e31;color:#e5b9ae;border:1px solid #594045}.training-own{background:#243b3c;color:#b2d6cd;border:1px solid #406761}.training-empty{color:#7b92a6;font-size:12px}.training-unit-stats{font-size:11px;font-variant-numeric:tabular-nums;white-space:nowrap}.training-lane-divider{color:#617a8e;text-align:center;font-size:10px;margin:8px}.training-lane-select{width:100%;display:flex;flex-direction:column;gap:4px;padding:3px;border-radius:8px;border:2px solid transparent;background:transparent;cursor:pointer;font:inherit;color:inherit}.training-lane-select .training-unit{width:100%}.training-lane-select:disabled{opacity:1}.training-selected{border-color:#ddb365!important;box-shadow:0 0 0 1px #ddb36555}.training-lane-hint{font-size:10px;color:#9eb4c6;padding:3px}.training-selected .training-lane-hint{color:#edca8e}.training-hand-heading{display:flex;align-items:center;justify-content:space-between;margin:18px 0 8px}.training-hand-heading h3{margin:0;font-size:13px}.training-hand-heading span{color:#819aae;font-size:11px}.training-hand{display:flex;gap:9px;overflow-x:auto;padding:3px 2px 9px;min-height:116px;scrollbar-width:thin}.training-hand-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:8px;flex:0 0 156px;min-height:112px;border:2px solid #415c70;border-radius:9px;background:linear-gradient(145deg,#2a4355,#1c3040);text-align:left;color:#eaf0f2;cursor:pointer;font:inherit;padding:14px 10px 10px}.training-hand-card:hover:not(:disabled){background:#355369}.training-card-name{font-size:13px;font-weight:600;overflow-wrap:anywhere}.training-hand-card .training-card-name{padding-right:20px}.training-hand-stats{font-size:11px;color:#bfced7;white-space:nowrap}.training-hand-card small{font-size:10px;color:#9fb6c8}.training-cost{position:absolute;top:6px;right:7px;display:flex;align-items:center;justify-content:center;width:25px;height:25px;border-radius:50%;background:#6c91bd;color:#fff;font-weight:700;font-size:13px}.training-empty-hand{color:#9db2c2;font-size:13px}.training-battle-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:10px}.training-battle-actions .training-primary{flex:1}.training-end-turn{background:#375957}.training-subtle{background:transparent;color:#b7b6b0}.training-log,.training-library{margin-top:17px;border-top:1px solid #344959;padding-top:12px;color:#a5b7c5;font-size:12px}.training-log summary,.training-library summary{cursor:pointer;color:#c6d2dc;min-height:24px}.training-log ol{margin:8px 0 0;padding-left:21px;line-height:1.8;color:#90a9bd}.training-library-content{padding-top:8px}.training-rules{margin:0 0 10px;font-size:12px;line-height:1.8;color:#92aabd}.training-catalog{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.training-catalog-card{display:grid;grid-template-columns:1fr auto;gap:7px;padding:11px 13px;border:1px solid #354c5e;background:#1b2c39;border-radius:7px;font-size:12px}.training-catalog-card span{color:#8ea7bb}.training-catalog-card small{grid-column:1/-1;color:#9bb2c5;font-size:11px}.training-panel button:focus-visible,.training-panel summary:focus-visible{outline:3px solid #b7d7ff;outline-offset:3px}.training-is-open #GameCanvas{pointer-events:none}
@media(max-width:700px){.training-overlay{padding:6px}.training-panel{max-height:calc(100dvh - 12px);border-radius:10px}.training-header{padding:13px 14px 10px}.training-heading h2{font-size:20px}.training-eyebrow{font-size:8px}.training-close{font-size:11px;padding:8px}.training-notice{padding:9px 14px;font-size:11px}.training-body{padding:13px 14px 18px}.training-profile{gap:8px 14px;font-size:11px}.training-player{font-size:14px}.training-record{margin-left:0}.training-toolbar{gap:6px}.training-button{font-size:11px;padding:8px 10px;min-height:37px}.training-lanes{gap:6px}.training-lane{padding:7px 4px}.training-unit{min-height:67px;padding:8px 3px}.training-card-name{font-size:11px}.training-unit-stats{font-size:9px}.training-lane-hint{font-size:9px}.training-scoreboard{padding:10px 8px;font-size:11px;gap:5px}.training-round strong{font-size:12px}.training-round span{font-size:10px}.training-hand-card{flex-basis:140px}.training-catalog{grid-template-columns:repeat(2,minmax(0,1fr))}.training-intro{padding:20px}.training-intro h3{font-size:16px}.training-result strong{font-size:18px}.training-result span{font-size:11px}}
