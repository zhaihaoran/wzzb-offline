/* Add after the original local/style.css. Keep the native canvas and its
   aspect ratio; only fit the surrounding viewport and touchable controls. */
:root{--phone-footer:48px;--phone-safe-top:env(safe-area-inset-top,0px);--phone-safe-bottom:env(safe-area-inset-bottom,0px)}html{width:100%;height:100%;overflow:hidden}body{width:100%;height:100vh;height:100dvh;min-height:0;overflow:hidden;box-sizing:border-box;padding:var(--phone-safe-top) env(safe-area-inset-right,0px) var(--phone-safe-bottom) env(safe-area-inset-left,0px);justify-content:center;overscroll-behavior:none;-webkit-text-size-adjust:100%}#GameDiv{flex:none;width:min(100%,calc((100dvh - var(--phone-safe-top) - var(--phone-safe-bottom) - var(--phone-footer))*1600/750));max-width:100%;max-height:calc(100dvh - var(--phone-safe-top) - var(--phone-safe-bottom) - var(--phone-footer));box-shadow:none}#Cocos3dGameContainer,#GameCanvas{touch-action:none;-webkit-user-select:none;user-select:none}footer{flex:0 0 var(--phone-footer);height:var(--phone-footer);min-height:var(--phone-footer);max-width:100%;width:100%;gap:8px;padding:2px 8px;overflow-x:auto;overflow-y:hidden;white-space:nowrap;scrollbar-width:none;-webkit-overflow-scrolling:touch}footer::-webkit-scrollbar{display:none}footer button,footer .footer-link,footer select{flex:none;min-height:42px;display:inline-flex;align-items:center;justify-content:center;padding:8px 10px;font-size:12px;touch-action:manipulation}footer select{width:135px;max-width:150px}footer #open-heroes,footer #original-battle,footer #restart{margin-left:0}footer #status{flex:none;max-width:115px;font-size:10px;overflow:hidden;text-overflow:ellipsis}footer #save-status,footer #control-message{display:none}#loading{padding:16px}#loading p{font-size:13px;letter-spacing:0}#error-details{font-size:10px}button,a,input,select{-webkit-tap-highlight-color:transparent}@media(orientation:portrait){body::before{content:"建议横屏游玩 · 底部操作栏可左右滑动";color:#cbb784;font-size:12px;line-height:1.7;position:absolute;top:calc(var(--phone-safe-top) + 18px);left:15px;right:15px;text-align:center;pointer-events:none}footer{position:absolute;bottom:var(--phone-safe-bottom);left:env(safe-area-inset-left,0px);right:env(safe-area-inset-right,0px);width:auto}#GameDiv{width:100%}}@media(orientation:landscape) and (max-height:450px){:root{--phone-footer:44px}footer{gap:5px;padding-inline:5px}footer button,footer .footer-link,footer select{font-size:11px;padding-inline:8px;min-height:40px}footer #status{max-width:90px}}@supports not (height:100dvh){#GameDiv{width:min(100%,calc((100vh - var(--phone-safe-top) - var(--phone-safe-bottom) - var(--phone-footer))*1600/750));max-height:calc(100vh - var(--phone-safe-top) - var(--phone-safe-bottom) - var(--phone-footer))}}
