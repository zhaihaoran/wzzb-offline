/* Explicit, local-only training rules layered over the original client. */
(function installTraining(global) {
  'use strict';
  const doc = global.document;
  const fetchLocal = global.__LOCAL_GAME__?.native?.fetch || global.fetch.bind(global);
  const state = { token: '', data: null, busy: false, selectedCard: null, selectedLane: 0, open: false };
  let returnFocus = null;

  function el(tag, className, text) {
    const node = doc.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = String(text);
    return node;
  }
  function button(text, className, action) {
    const node = el('button', className, text); node.type = 'button';
    if (action) node.addEventListener('click', action);
    return node;
  }
  function number(value) { return Number(value || 0).toLocaleString('zh-CN'); }
  function name(card) { return String(card?.name || ('卡牌 ' + (card?.id || card?.card_id || ''))); }
  function cards() { return new Map((state.data?.cards || []).map(card => [String(card.id), card])); }
  function playing() { return state.data?.battle?.status === 'playing'; }
  function clear(node) { node.replaceChildren(); }
  const translated = new Map([
    ['Not enough mana', '法力不足，请选择其他卡牌或结束回合。'],
    ['That lane is occupied', '该路已有己方单位，请选择其他路线。'],
    ['Not enough local gold', '本地金币不足。'],
    ['Finish or surrender the current training duel first', '请先完成或结束当前演练。'],
    ['No active local training duel', '当前没有进行中的演练。'],
    ['Start a local training duel first', '请先开始一场演练。'],
  ]);

  const overlay = el('div', 'training-overlay');
  overlay.hidden = true;
  const panel = el('section', 'training-panel');
  panel.setAttribute('role', 'dialog'); panel.setAttribute('aria-modal', 'true'); panel.setAttribute('aria-labelledby', 'training-title');
  const header = el('header', 'training-header');
  const heading = el('div', 'training-heading');
  const eyebrow = el('span', 'training-eyebrow', 'LOCAL · 原游戏旁的本地演练');
  const title = el('h2', '', '本地演练'); title.id = 'training-title';
  heading.append(eyebrow, title);
  const close = button('关闭演练 ×', 'training-close', closeTraining);
  header.append(heading, close);
  const notice = el('p', 'training-notice', '简化本地战斗：原卡牌数值，三路回合制规则；不等同原服战斗');
  const body = el('div', 'training-body');
  const profile = el('div', 'training-profile');
  const toolbar = el('div', 'training-toolbar');
  const start = button('开始演练', 'training-button training-primary', () => run('startBattle', {}, '新的演练已开始。'));
  const train = button('训练英雄', 'training-button', () => run('train', {}, '英雄训练完成，金币与等级已保存。'));
  const refresh = button('刷新存档', 'training-button', () => refreshTraining());
  toolbar.append(start, train, refresh);
  const message = el('p', 'training-message', '正在读取本地存档…');
  message.setAttribute('role', 'status'); message.setAttribute('aria-live', 'polite');
  const arena = el('div', 'training-arena');
  const library = el('details', 'training-library');
  const librarySummary = el('summary', '', '查看本地卡牌与规则');
  const libraryContent = el('div', 'training-library-content');
  library.append(librarySummary, libraryContent);
  body.append(profile, toolbar, message, arena, library);
  panel.append(header, notice, body); overlay.appendChild(panel); doc.body.appendChild(overlay);

  async function post(path, payload) {
    const controller = new AbortController(), timeout = setTimeout(() => controller.abort(), 12000);
    try {
      const response = await fetchLocal(new URL(path, global.location.origin).href, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
        body: JSON.stringify(payload), signal: controller.signal,
      });
      if (!response.ok) throw new Error('本地服务返回 HTTP ' + response.status);
      const data = await response.json();
      if (data.state !== 0) {
        if (data.state === -5) state.token = '';
        throw new Error(translated.get(data.message) || data.message || '本地操作失败（' + data.state + '）');
      }
      return data;
    } catch (error) {
      if (error.name === 'AbortError') throw new Error('本地服务响应超时，请检查启动终端。');
      throw error;
    } finally { clearTimeout(timeout); }
  }
  async function login() {
    if (state.token) return;
    const data = await post('/api/login', { api: 'user', c: 'login', account: 'local-player', pwd: '' });
    if (!data.sessionToken) throw new Error('本地登录没有返回会话。');
    state.token = data.sessionToken;
  }
  async function request(action, payload = {}) {
    await login();
    return post('/api/local', { api: 'local', c: action, sessionToken: state.token, ...payload });
  }
  function setMessage(text, error = false) {
    message.textContent = text; message.classList.toggle('training-error', error);
  }
  function setBusy(value) { state.busy = value; render(); }
  async function run(action, payload = {}, feedback = '') {
    if (state.busy) return;
    setBusy(true);
    try {
      const data = await request(action, payload); state.data = data;
      if (['playCard', 'startBattle', 'surrender'].includes(action)) state.selectedCard = null;
      const emptyLane = data.battle?.lanes?.findIndex(lane => !lane);
      if (emptyLane >= 0 && data.battle.lanes[state.selectedLane]) state.selectedLane = emptyLane;
      setMessage(feedback || '本地存档已更新。');
    } catch (error) { setMessage(error.message || String(error), true); }
    finally { setBusy(false); }
  }
  async function refreshTraining() { await run('getState', {}, '已读取本地存档。'); }

  function render() {
    const data = state.data, duel = data?.battle;
    clear(profile);
    if (data) {
      const hero = data.heroes?.[0];
      profile.append(el('strong', 'training-player', data.role?.name || '本地领主'));
      profile.append(el('span', '', '金币 ' + number(data.currencies?.[1])));
      profile.append(el('span', '', '英雄 Lv.' + number(hero?.level || 1)));
      profile.append(el('span', '', (data.cards || []).length + ' 种卡牌'));
      profile.append(el('span', 'training-record', number(data.stats?.wins) + ' 胜 / ' + number(data.stats?.battles) + ' 场'));
      train.textContent = '训练英雄 · ' + number((hero?.level || 1) * 100) + ' 金币';
    } else profile.append(el('span', '', '本地账号 local-player'));
    start.disabled = state.busy || playing();
    start.textContent = duel && duel.status !== 'playing' ? '再来一场' : '开始演练';
    train.disabled = state.busy || !data || Number(data.currencies?.[1] || 0) < Number(data.heroes?.[0]?.level || 1) * 100;
    refresh.disabled = state.busy;
    panel.setAttribute('aria-busy', String(state.busy));
    renderArena(duel);
    renderLibrary();
  }

  function unitCard(unit, enemy) {
    const node = el('div', 'training-unit ' + (enemy ? 'training-enemy' : 'training-own'));
    if (!unit) { node.append(el('span', 'training-empty', enemy ? '敌方空位' : '己方空位')); return node; }
    node.append(el('strong', 'training-card-name', name(unit)));
    node.append(el('span', 'training-unit-stats', '攻击 ' + number(unit.atk) + ' · 生命 ' + number(unit.hp)));
    return node;
  }
  function renderArena(duel) {
    clear(arena);
    if (!duel) {
      const introduction = el('div', 'training-intro');
      introduction.append(el('h3', '', '用现有卡牌完成一场三路演练'));
      introduction.append(el('p', '', '每轮选择手牌与空路线后部署。结束回合时，双方同路单位同时攻击；空路直接攻击领主。'));
      introduction.append(el('p', '', '法力从 3 点开始逐轮增加，上限 10 点，每轮回满并补一张牌。领主生命归零后结算，本地进度会自动保存。'));
      arena.append(introduction); return;
    }
    const scoreboard = el('div', 'training-scoreboard');
    scoreboard.append(el('div', 'training-own-score', '你的生命 ' + number(duel.playerHp)));
    const round = el('div', 'training-round');
    round.append(el('strong', '', '第 ' + number(duel.round) + ' 轮'));
    round.append(el('span', '', '法力 ' + number(duel.mana) + ' / ' + number(duel.maxMana)));
    scoreboard.append(round, el('div', 'training-enemy-score', '对手生命 ' + number(duel.enemyHp)));
    arena.append(scoreboard);
    if (duel.status !== 'playing') {
      const result = el('div', 'training-result ' + (duel.status === 'won' ? 'training-won' : 'training-lost'));
      result.append(el('strong', '', duel.status === 'won' ? '演练获胜' : '演练结束'));
      if (duel.reward) result.append(el('span', '', '本地奖励：金币 +' + number(duel.reward.gold) + ' · 角色经验 +' + number(duel.reward.exp)));
      arena.append(result);
    }
    const lanes = el('div', 'training-lanes');
    for (let index = 0; index < 3; index++) {
      const lane = el('div', 'training-lane');
      lane.append(el('h3', '', '第 ' + (index + 1) + ' 路'), unitCard(duel.enemyLanes?.[index], true));
      lane.append(el('div', 'training-lane-divider', '↓ 交战 ↑'));
      const select = button('', 'training-lane-select', () => { state.selectedLane = index; render(); });
      const occupied = Boolean(duel.lanes?.[index]);
      select.append(unitCard(duel.lanes?.[index], false));
      select.disabled = state.busy || duel.status !== 'playing' || occupied;
      select.classList.toggle('training-selected', state.selectedLane === index && !occupied);
      select.setAttribute('aria-pressed', String(state.selectedLane === index && !occupied));
      select.setAttribute('aria-label', '选择第 ' + (index + 1) + ' 路' + (occupied ? '，已有己方单位' : ''));
      if (!occupied && duel.status === 'playing') select.append(el('span', 'training-lane-hint', state.selectedLane === index ? '已选择这一路' : '选择这一路'));
      lane.append(select); lanes.append(lane);
    }
    arena.append(lanes);
    const handHeading = el('div', 'training-hand-heading');
    handHeading.append(el('h3', '', '手牌 ' + (duel.hand?.length || 0)), el('span', '', '牌堆剩余 ' + (duel.deck?.length || 0) + ' 张'));
    arena.append(handHeading);
    const hand = el('div', 'training-hand'), catalog = cards();
    for (const [index, id] of (duel.hand || []).entries()) {
      const card = catalog.get(String(id)) || { id };
      const item = button('', 'training-hand-card', () => { state.selectedCard = index; render(); });
      item.append(el('span', 'training-cost', number(card.mp)), el('strong', 'training-card-name', name(card)));
      item.append(el('span', 'training-hand-stats', '攻击 ' + number(card.atk) + '  /  生命 ' + number(card.hp)));
      const affordable = Number(card.mp || 1) <= Number(duel.mana);
      item.append(el('small', '', affordable ? '点击选择' : '法力不足'));
      item.disabled = state.busy || duel.status !== 'playing' || !affordable;
      item.classList.toggle('training-selected', state.selectedCard === index);
      item.setAttribute('aria-pressed', String(state.selectedCard === index));
      item.setAttribute('aria-label', name(card) + '，法力 ' + number(card.mp) + '，攻击 ' + number(card.atk) + '，生命 ' + number(card.hp));
      hand.append(item);
    }
    if (!duel.hand?.length) hand.append(el('p', 'training-empty-hand', '没有手牌，结束回合可从牌堆补牌。'));
    arena.append(hand);
    if (duel.status === 'playing') {
      const actions = el('div', 'training-battle-actions');
      const selected = state.selectedCard == null ? null : catalog.get(String(duel.hand[state.selectedCard]));
      const deploy = button(selected ? '部署 ' + name(selected) + ' → 第 ' + (state.selectedLane + 1) + ' 路' : '先选择一张手牌', 'training-button training-primary',
        () => run('playCard', { handIndex: state.selectedCard, lane: state.selectedLane }, '卡牌已部署，可继续出牌或结束回合。'));
      deploy.disabled = state.busy || !selected || Boolean(duel.lanes[state.selectedLane]);
      const end = button('结束回合', 'training-button training-end-turn', () => run('endTurn', {}, '回合已结算。'));
      end.disabled = state.busy;
      const surrender = button('结束本场', 'training-button training-subtle', () => run('surrender', {}, '本场演练已结束，本地奖励已保存。'));
      surrender.disabled = state.busy;
      actions.append(deploy, end, surrender); arena.append(actions);
    }
    const logs = el('details', 'training-log');
    logs.open = true; logs.append(el('summary', '', '最近战斗记录'));
    const list = el('ol', '');
    for (const line of (duel.log || []).slice(-8)) list.append(el('li', '', line));
    logs.append(list); arena.append(logs);
  }
  function renderLibrary() {
    clear(libraryContent);
    libraryContent.append(el('p', 'training-rules', '原卡牌攻击、生命与法力来自本机缓存配置。演练不实现原服技能、阵型和概率。英雄每提升 2 级，后续部署单位攻击 +1；每场奖励按本地简化规则结算。'));
    const list = el('div', 'training-catalog');
    for (const card of state.data?.cards || []) {
      const row = el('div', 'training-catalog-card');
      row.append(el('strong', '', name(card)), el('span', '', '×' + number(card.count)));
      row.append(el('small', '', '法力 ' + number(card.mp) + ' · 攻击 ' + number(card.atk) + ' · 生命 ' + number(card.hp)));
      list.append(row);
    }
    libraryContent.append(list);
  }

  async function openTraining() {
    if (state.open) return;
    returnFocus = doc.activeElement; state.open = true; overlay.hidden = false;
    doc.body.classList.add('training-is-open'); close.focus();
    if (state.data) render();
    await refreshTraining();
  }
  function closeTraining() {
    state.open = false; overlay.hidden = true; doc.body.classList.remove('training-is-open');
    returnFocus?.focus?.();
  }
  doc.addEventListener('click', event => {
    if (event.target.closest?.('[data-local-training]')) openTraining();
  });
  overlay.addEventListener('click', event => { if (event.target === overlay) closeTraining(); });
  overlay.addEventListener('keydown', event => {
    if (event.key === 'Escape') { event.preventDefault(); closeTraining(); return; }
    if (event.key !== 'Tab') return;
    const focusable = [...panel.querySelectorAll('button:not(:disabled), summary, [tabindex="0"]')].filter(node => !node.hidden);
    const first = focusable[0], last = focusable[focusable.length - 1];
    if (event.shiftKey && doc.activeElement === first) { event.preventDefault(); last?.focus(); }
    else if (!event.shiftKey && doc.activeElement === last) { event.preventDefault(); first?.focus(); }
  });
  global.__LOCAL_TRAINING__ = { open: openTraining, close: closeTraining, refresh: refreshTraining };
  render();
})(window);
