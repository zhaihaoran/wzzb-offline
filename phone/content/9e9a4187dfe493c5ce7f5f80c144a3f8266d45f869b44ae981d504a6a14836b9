:root{color-scheme:dark;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;background:#101419;color:#f2e8cb}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(ellipse at top,#293342,#101419 70%);overflow:hidden}#GameDiv{position:relative;width:min(100vw,calc((100vh - 42px)*1600/750));aspect-ratio:1600/750;overflow:hidden;box-shadow:0 20px 90px #0008}#Cocos3dGameContainer,#GameCanvas{width:100%;height:100%;display:block}#GameCanvas{outline:none;touch-action:none}#loading{position:absolute;inset:0;background:linear-gradient(145deg,#192835,#13212b);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:24px}#loading img{max-width:52%;max-height:38%;object-fit:contain}#loading p{font-size:15px;letter-spacing:1px}progress{width:min(320px,70%);height:6px;accent-color:#e6bd68}#error-details{max-height:30%;max-width:90%;overflow:auto;white-space:pre-wrap;font-size:12px;color:#f2a69a}footer{width:min(100vw,1600px);height:38px;display:flex;align-items:center;gap:20px;padding:0 16px;color:#a5b3bd;font-size:12px}footer button{margin-left:auto;border:1px solid #4a5660;border-radius:4px;background:transparent;color:#d6dde2;padding:4px 12px;cursor:pointer}#save-status{opacity:.75}
footer button[data-local-training]{margin-left:auto}footer #restart{margin-left:0}
@media(max-width:640px){footer{gap:8px;padding:0 6px;font-size:10px}#save-status{display:none}}
footer #original-battle{margin-left:auto;white-space:nowrap}.footer-link{color:#e6bd68;text-decoration:none;border:1px solid #4a5660;border-radius:4px;padding:4px 10px;white-space:nowrap}#control-message{color:#e6bd68;max-width:35vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}footer #restart{margin-left:0;white-space:nowrap}
@media(max-width:900px){#control-message{max-width:20vw}footer{gap:8px}#save-status{display:none}}
footer select { background: #131c24; color: #e3d8aa; border: 1px solid #4b5158; border-radius: 5px; padding: 5px 7px; font: inherit; max-width: 210px; }

footer #open-heroes,footer #open-altar{margin-left:0;white-space:nowrap}footer #original-battle{margin-left:0}footer #open-heroes{margin-left:auto}@media(max-width:900px){#status{max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}footer{gap:5px;padding-inline:5px}footer button,.footer-link{padding-inline:7px}#control-message{display:none}footer select{max-width:145px}}
