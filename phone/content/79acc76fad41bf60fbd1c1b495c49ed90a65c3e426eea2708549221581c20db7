/** Return a new table container; original row objects/ZIP bytes are unchanged. */
export function withLocalSkillRepairs(tables) {
  if (!Array.isArray(tables?.skill_configs)) throw new TypeError("skill_configs is required");
  const existing = new Set(tables.skill_configs.map(row => String(row.id)));
  const additions = LOCAL_SKILL_REPAIRS.filter(row => !existing.has(String(row.id))).map(row => structuredClone(row));
  return { ...tables, skill_configs: [...tables.skill_configs, ...additions] };
}
