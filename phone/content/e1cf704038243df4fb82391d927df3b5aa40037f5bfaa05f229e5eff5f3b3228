/** Repairs for the recovered offline client's equipment and guard screens.
 * The original panels, API mutations, ownership and resource rules remain in
 * use; only the user's local test-entry gates and invalid UI state are fixed.
 */
const installed = new WeakMap();

export function installFeatureClientRepairs(exports, local) {
  if (typeof local?.getExport !== 'function') throw new TypeError('Feature repairs need the client export registry');
  let changed = false;
  const enabled = () => local.testHeroFeatures === true;
  function once(target, name, install) {
    if (!target) return;
    let names = installed.get(target); if (!names) installed.set(target, names = new Set());
    if (names.has(name)) return;
    if (install() === false) return;
    names.add(name); changed = true;
  }
  function wrap(target, name, repair) {
    if (typeof target?.[name] !== 'function') return;
    once(target, name, () => {
      const original = target[name];
      target[name] = function (...args) { return enabled() ? repair.call(this, original, args) : original.apply(this, args); };
    });
  }

  // FunctionData's unlock table is not the only entrance gate. These two
  // constants are read independently by HeroSkillEquipUI and HeroTool.
  const config = exports.GameConfig;
  for (const name of ['hero_wuqi_unlock_lv', 'hero_baowu_unlock_lv']) once(config, name, () => {
    const descriptor = Object.getOwnPropertyDescriptor(config, name);
    if (!descriptor || !descriptor.configurable || typeof descriptor.value !== 'number') return false;
    let original = descriptor.value;
    Object.defineProperty(config, name, { configurable: descriptor.configurable, enumerable: descriptor.enumerable,
      get() { return enabled() ? 1 : original; }, set(value) { original = value; } });
  });

  wrap(exports.CfgData2, 'getCfgPetLevelUpById', function (original, args) {
    const row = original.apply(this, args);
    // PetData's red-dot check and PetUpLevelPop both read this field directly.
    // Return a view, leaving the trusted cached recipe and all other fields as
    // shipped. Costs, max levels and level-specific stat gains remain real.
    return row && Number(row.role_lv) > 1 ? { ...row, role_lv: 1 } : row;
  });

  wrap(exports.PetDrawPanel?.prototype, 'getRemainNumToLevelUpByLevel', function (_original, _args) {
    // This helper is only the draw-count admission threshold. Native UI still
    // uses actual pool num, probabilities, next-row existence and rewards.
    return 0;
  });

  wrap(exports.PetTool, 'getPetPowerByInfo', function (_original, [pet]) {
    if (!pet) return 0;
    if (Number.isFinite(Number(pet.power)) && Number(pet.power) > 0) return Number(pet.power);
    const card = local.getExport('CfgData')?.getCfgCardById?.(pet.card_id);
    const cfg = local.getExport('CfgData2');
    if (!card || !cfg) return 0;
    let power = Number(card.power) || 0;
    const rows = cfg.getCfgPetStarUpArrByPetId(pet.pet_id) || [];
    const target = `${pet.pet_id}_${pet.grade}_${pet.star}`;
    const end = rows.findIndex(row => String(row.id) === target);
    // The shipped implementation increments card.power itself. Rendering a
    // pet twice then inflates every subsequent pet's base card configuration.
    for (let index = 0; index < end; index++) power += Number(rows[index].add_power) || 0;
    for (let level = 1; level < Number(pet.level); level++) power += Number(cfg.getCfgPetLevelUpById(pet.pet_id, level)?.add_power) || 0;
    return power + Math.ceil(power * (Number(this.getPetSkillPowerPercent(pet.skills)) || 0) / 100);
  });

  wrap(exports.PetTool, 'openPetDetailPanel', async function (original, [id, ...rest]) {
    await this.initData();
    const pets = local.getExport('PetData')?.petList || {};
    const heroId = local.getExport('RoleData')?.getRole?.()?.card_id;
    const carriedId = local.getExport('MasterCardData')?.getCardById?.(heroId)?.pet_id;
    // A deleted or migrated pet link must not become selectIndex=-1 in the
    // original detail panel. A valid explicit/current selection is preserved.
    const selected = [id, carriedId, ...Object.keys(pets)].find(candidate => candidate != null && Object.hasOwn(pets, String(candidate)));
    return original.call(this, selected == null ? undefined : String(selected), ...rest);
  });

  const slots = exports.HeroSkillEquipUI?.prototype;
  for (const name of ['on_btn_equip1', 'on_btn_equip2']) wrap(slots, name, async function (original, args) {
    // HeroCKPanel can be opened directly by the testing toolbar, before the
    // town panel's normal equipment-loader path has finished.
    await local.getExport('HeroEquipTool')?.initEquipData?.();
    return original.apply(this, args);
  });

  wrap(exports.HeroEquipChoosePop?.prototype, 'onEquipUpdate', function (original, args) {
    // The central data receiver has already applied this update. Selection is
    // populated asynchronously by the original list, so there is no item to
    // redraw until that selection arrives.
    if (!this.equip) return;
    return original.apply(this, args);
  });

  wrap(exports.ActWeekData, 'onSetMainData', function (original, args) {
    const previous = this.localWeeklyInstance;
    this.localWeeklyInstance = args[0]?.localWeeklyInstance === true;
    try { return original.apply(this, args); }
    catch (error) { this.localWeeklyInstance = previous; throw error; }
  });
  wrap(exports.ActWeekData, 'getIsOpenEnterByType', function (original, args) {
    // FunctionTool hard-codes the generic weekly button to BoxMonster=2. The
    // same shipped main panel also implements mining, whose complete cached
    // phase is the explicit local event instance rather than that old schedule.
    if (this.localWeeklyInstance && Number(args[0]) === 2) return !this.isClose && this.isInTimeRound;
    return original.apply(this, args);
  });
  wrap(exports.ActWeekTool, 'onOpenActWeekMainPanel', async function (original, args) {
    const data = local.getExport('ActWeekData'), api = local.getExport('BaseApi');
    if (!data || !api?.requestLogic) return original.apply(this, args);
    const result = await new Promise(resolve => api.requestLogic({ api: 'limitWeek', c: 'getInfo' }, resolve, error => {
      local.getExport('ApiState')?.showText(error?.message || '当前无法读取本地周活动，请稍后重试'); resolve(null);
    }));
    if (!result) return false;
    if (!data.shopInfo) data.onInitData();
    data.onSetMainData(result);
    if (!data.localWeeklyInstance) return original.apply(this, args);
    if (data.isClose || !data.isInTimeRound) { local.getExport('ApiState')?.showText('本期本地周活动尚未开放或已经结束'); return false; }
    const panel = await local.getExport('ActWeekMainPanel').createInstance();
    this.isInit = true; local.getExport('PanelTween').pushPanel(panel); return true;
  });
  return changed;
}
