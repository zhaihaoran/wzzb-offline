        return ok({ list: Object.fromEntries(pages[page].map(key => [key, ranking(player, key).list[0] || {}])), localRankScope: 'Saved local players only; cached minimum scores apply.' });
      }
      case 'rank.getDayRank': return ok({ list: [], user: { ...entry(player, String(pars.key || 'powers')), rank: -1 }, localArchiveState: 'No daily ranking settlement has been recorded.' });
      case 'rank.getLimitTimeRankList': return ok({ limitTimeRankList: { list: [], user: { ...entry(player, String(pars.key || 'powers')), rank: -1 } }, localActivityState: 'No local limited ranking instance is scheduled.' });
      case 'rank.getLimitRankInfo': return fail(-409, '本地没有进行中的限时排行榜实例');
      case 'rank.getUpvoteRew': case 'rank.getLimitRankReward': case 'rank.getDayRankReward': return fail(-409, '本地未生成该排行榜的结算奖励，无法领取');
