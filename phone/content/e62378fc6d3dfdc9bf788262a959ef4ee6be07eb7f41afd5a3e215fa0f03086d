  if (request.headers['sec-fetch-site'] === 'cross-site') reject('不接受其他网站访问本地存档。', 403);
  const source = request.headers.origin;
  if (source !== undefined) {
    let origin;
    try { origin = new URL(source).origin; } catch { reject('请求来源无效。', 403); }
    if (origin !== base.origin) reject('仅允许当前本地页面访问此服务。', 403);
