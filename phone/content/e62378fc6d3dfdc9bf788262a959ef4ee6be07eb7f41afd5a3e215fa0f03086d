// The explicit unrestricted test profile gets a separately named configured
// local mining instance; no remote participants are generated.
import { clone } from './mock-state.mjs';
import { createLocalEventReaders } from './local-event-readers.mjs';

const pages = {
  1: ['powers', 'roleLevelRank', 'tt', ...Array.from({ length: 7 }, (_, i) => \`powerRace\${i + 1}\`)],
  2: ['summon', 'home', 'adventure', 'shopDust', 'yzMaxNum', 'yzMap', 'towerLayerRank'],
  3: ['zyYzKingSuccess', 'zyKingSuccess', 'zyMaxLevelRank', ...Array.from({ length: 7 }, (_, i) => \`zyRace\${i + 1}\`)],
};
const supported = new Set([...Object.values(pages).flat(), 'master', 'masterBase', 'masterCardGrade5', 'masterCardGrade6', 'masterCardGrade7']);

export function createLocalReaders({ tables, getStore, ok, fail }) {
  const events = createLocalEventReaders({ tables, getStore, ok, fail });
  const cards = new Map(tables.card_configs.map(row => [String(row.id), row]));
  const levels = new Map(tables.zhanyi_level_configs.map(row => [String(row.id), row]));
  const minimums = new Map(tables.rank_min_score_configs.map(row => [row.id, Number(row.score) || 0]));
  const totalPower = player => [...Array.from({ length: 7 }, (_, i) => i + 1), 10001, 10002].reduce((sum, key) => sum + Number(player.power[key] || 0), 0);
  function cleared(player) {
    const combined = { ...player.local.zhanyiCleared, ...player.local.originalBattleWins };
    return Object.entries(combined).filter(([, count]) => Number(count) > 0).map(([id]) => levels.get(String(id))).filter(Boolean);
  }
  function score(player, key) {
    const [base, param] = key.split(':'), wins = cleared(player);
    if (base === 'powers') return totalPower(player);
    if (/^powerRace[1-7]$/.test(base)) return Number(player.power[base.at(-1)] || 0);
    if (base === 'roleLevelRank') return player.role.level;
    if (base === 'summon') return player.local.drawCount || 0;
    if (base === 'home') return player.local.home?.totalManpower || 0;
    if (base === 'master') return Math.max(0, ...player.masterCard.filter(h => h.activate).map(h => h.power || 0));
    if (base === 'masterBase') return Math.max(0, ...player.masterCard.filter(h => h.activate && String(h.base_card_id) === param).map(h => h.power || 0));
    if (/^masterCardGrade[567]$/.test(base)) return player.masterCard.filter(h => h.activate && cards.get(String(h.card_id))?.grade === Number(base.at(-1))).length;
    if (base === 'zyMaxLevelRank') return Math.max(0, ...wins.filter(row => row.main_judge === 1).map(row => Number(row.zy_rank_id) || 0));
    if (/^zyRace[1-7]$/.test(base)) return wins.filter(row => Number(row.race) === Number(base.at(-1))).reduce((sum, row) => sum + (Number(row.rank_score) || 0), 0);
    if (base === 'zyKingSuccess') return wins.filter(row => Number(row.wz_rank) > 0).reduce((sum, row) => sum + (Number(row.rank_score) || 0), 0);
    if (base === 'zyYzKingSuccess') return wins.filter(row => row.camp_type === 2 && Number(row.wz_rank) > 0).length;
