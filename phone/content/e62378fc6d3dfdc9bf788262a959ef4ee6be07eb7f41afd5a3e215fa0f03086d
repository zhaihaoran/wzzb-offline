      case 'limitWeek.getServerAvsNum': return ok({ serverAvsNum: 0 });
      case 'limitWeek.buyGoods': case 'limitWeek.extractReward': case 'limitWeek.getAvsReward': case 'limitWeek.selectedRace': return fail(-409, '本地没有进行中的周活动实例，当前操作不可用');
      default: return null;
    }
  } };
}
