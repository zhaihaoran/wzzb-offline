  for (let level = 1; level < Number(pet.level); level++) {
    const row = cfg.levels.get(\`\${pet.pet_id}_\${level}\`);
    hp += Number(row?.add_hp) || 0; atk += Number(row?.add_atk) || 0; power += Number(row?.add_power) || 0;
  }
  const percent = (pet.skills || []).reduce((sum, id) => sum + Number(cfg.books.get(Number(id))?.power || 0), 0);
  power += Math.ceil(power * percent / 100);
