    return { ...clone(player.role), score: score(player, key), gs_id: 'local', server_id: 'local' };
  }
  function ranking(player, key) {
    const base = key.split(':')[0], minimum = minimums.get(base) || 0;
    const list = Object.values(getStore().players).map(p => entry(p, key)).filter(row => row.score >= minimum).sort((a, b) => b.score - a.score || a.uid.localeCompare(b.uid)).map((row, index) => ({ ...row, rank: index + 1 }));
