    const event = events.handle(action, pars, player); if (event !== null) return event;
    switch (action) {
      case 'rank.getRankList': {
        const key = String(pars.key || 'powers'), base = key.split(':')[0];
        if (!supported.has(base)) return fail(-409, '此排行榜所属玩法尚未在本地模拟');
        if (base === 'masterBase' && !cards.has(key.split(':')[1])) return fail(-400, '请选择缓存中存在的英雄');
