      const values = line.split('\\t');
      return Object.fromEntries(keys.map((key, index) => {
        const value = values[index]?.trim() ?? '';
        return [key.trim(), value !== '' && Number.isFinite(Number(value)) ? Number(value) : value];
      }));
    });
