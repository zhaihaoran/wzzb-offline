      info: { id: cfg.id, start_time: 0, end_time: 0, set_time: 0, isClose: 1 },
      dayMfNum: 0, serverAvsNum: 0, propNum: player.prop[cfg.add_prop_id] || 0,
      playerInfo: null, groupList: [], shopList: {}, playerAvsList: {}, playerServerAvsList: {},
      localActivityState: 'No local weekly activity instance is scheduled.',
    };
  }
